{
  "description": "Synchronize changed Stacktrace runtime state without blocking Claude Code, and render findings the CLI has already decided to surface.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/launch_auto_sync.py",
            "async": true
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/render_finding.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/launch_auto_sync.py",
            "async": true
          }
        ]
      }
    ]
  }
}
