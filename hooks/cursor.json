{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "sh ./scripts/session_start.sh --agent-kind cursor",
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "sh ./scripts/policy_hook.sh admit --agent-kind cursor",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh ./scripts/policy_hook.sh admit --agent-kind cursor",
        "timeout": 5
      }
    ]
  }
}
